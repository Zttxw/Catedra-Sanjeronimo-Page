# ─── HTACCESS CONFIGURATION FOR CPANEL APACHE ───
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redireccionar url con /index.html a la versión limpia sin index.html (/catedra/)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ .*/index\.html\ HTTP/
  RewriteRule ^index\.html$ ./ [R=301,L]

  # Enrutamiento de la API /api/* -> api.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]
</IfModule>

# Permisos y tipos MIME
AddDefaultCharset UTF-8

# ─── ANTI-CACHE CONTROL GLOBALES (Evita la necesidad de Ctrl + Shift + R) ───
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  
  <FilesMatch "\.(html|htm|php|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
